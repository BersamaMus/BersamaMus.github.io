---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import icon from '../../assets/vessel/icon.png';
import windowsHome from '../../assets/vessel/windows-home.png';
import windowsWatch from '../../assets/vessel/windows-watch.png';
import windowsFolder from '../../assets/vessel/windows-folder.png';

const repo = 'https://github.com/BersamaMus/Vessel';
const download = `${repo}/releases/latest/download/Vessel-Setup.exe`;
// The Android app, from the same release. A newer one installs over the old one and keeps its history.
const apk = `${repo}/releases/latest/download/Vessel.apk`;
---

<Base
  title="Vessel: offline video player for Windows and Android"
  description="Vessel plays the videos on your PC, your drives and your phone, with thumbnails, a mini player and Continue watching. No accounts, no ads, no internet."
  image={windowsHome.src}
  favicon={icon.src}
  section="projects"
>
  <div class="vessel accent-purple">
    <div class="hero">
      <div class="wrap">
        <p class="name"><Image src={icon} alt="" width={36} height={36} />Vessel</p>
        <h1>Your videos.<br /><span>All in one place.</span></h1>
        <p class="lead">
          Vessel turns the videos on your PC, your drives and your phone into a library you'll
          actually enjoy browsing. No accounts, no ads, no internet.
        </p>
        <div class="cta">
          <div class="buttons">
            <a class="btn" href={download} data-platform="windows">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5 10.4 4.5v7H3zM11.4 4.4 21 3v8.5h-9.6zM3 12.5h7.4v7L3 18.5zM11.4 12.5H21V21l-9.6-1.4z"/></svg>
              Download for Windows
            </a>
            <a class="btn secondary" href={apk} data-platform="android">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.6 9.48l1.84-3.18a.38.38 0 0 0-.66-.38l-1.86 3.22A11.5 11.5 0 0 0 12 8.2c-1.76 0-3.42.34-4.92.94L5.22 5.92a.38.38 0 0 0-.66.38L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z"/></svg>
              Download for Android
            </a>
          </div>
          <small><span id="version">Free</span> · Windows 10 and 11, 64-bit · Android 10 and up · <a href={`${repo}/releases`}>All releases</a></small>
        </div>
        <Image class="shot" src={windowsHome} alt="Vessel on Windows, showing Continue watching, recently added videos and library folders" loading="eager" />
      </div>
    </div>

    <section>
      <div class="wrap">
        <h2>A library, not a file list</h2>
        <p class="sub">Vessel finds the videos in your Videos folder and keeps up as you add more.</p>
        <div class="features">
          <div class="feature">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></div>
            <h3>Thumbnails for everything</h3>
            <p>Every video and folder gets a picture, made in the background and remembered, so the library opens instantly.</p>
          </div>
          <div class="feature">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
            <h3>Continue watching</h3>
            <p>Pick up where you left off, from Home or any folder. Finished videos are marked as watched.</p>
          </div>
          <div class="feature">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></div>
            <h3>Drives and phones</h3>
            <p>Plug in a USB drive or an Android phone and its videos appear. Phone videos play straight off the phone, no copying.</p>
          </div>
          <div class="feature">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></div>
            <h3>Search, sort and filter</h3>
            <p>Find anything by title or folder, ignoring accents and punctuation. Sort by name, length, size or release year.</p>
          </div>
          <div class="feature">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 15h4M13 15h4M7 11h10"/></svg></div>
            <h3>Subtitles that find themselves</h3>
            <p>Subtitle files that belong to a video are spotted, even in a Subs folder, and offered the first time you play it.</p>
          </div>
          <div class="feature">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z"/></svg></div>
            <h3>Private by design</h3>
            <p>Vessel never goes online. Your library, history and thumbnails stay on your device.</p>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Made for watching</h2>
        <p class="sub">Plays just about any video file, smoothly, and stays out of the way.</p>
        <ul class="desktop">
          <li><b>Mini player:</b> keep browsing while it plays</li>
          <li><b>Up next</b> from the same folder, with autoplay</li>
          <li><b>Seek previews</b> when you hover the timeline</li>
          <li><b>Media keys</b> and the Windows media flyout</li>
          <li><b>Swipe and double-tap</b> to skip, go full screen or shrink it</li>
          <li><b>Shortcuts:</b> <kbd>Space</kbd> play, <kbd>J</kbd>/<kbd>L</kbd> skip, <kbd>F</kbd> full screen</li>
        </ul>
        <Image class="shot" src={windowsWatch} alt="Vessel's watch page, with the video, its details and the rest of the folder up next" />
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Every folder, at a glance</h2>
        <p class="sub">Browse folder by folder, or sort and filter a whole folder tree in one grid.</p>
        <Image class="shot" src={windowsFolder} alt="A folder in Vessel, showing its videos as a grid of thumbnails, with the mini player in the corner" />
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Also on Android</h2>
        <p class="sub">The same Vessel on your phone, for the videos on its storage and SD card. Install it from here.</p>
        <ul class="desktop">
          <li><b>Your phone's videos</b> as a library, by folder, kept up to date</li>
          <li><b>Continue watching</b> and Quick picks on Home</li>
          <li><b>Mini player</b> and picture-in-picture</li>
          <li><b>Swipe to seek</b>, double-tap to skip, turn sideways for full screen</li>
          <li><b>Plays in the background</b>, with lock screen controls</li>
          <li><b>Open with Vessel</b> from your file manager</li>
        </ul>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Under the hood</h2>
        <p class="sub">
          Vessel for Windows is written in C++ with Qt Quick, and plays video with libmpv, the engine
          behind mpv, so it handles just about any format. On Android it's Kotlin and Jetpack Compose,
          playing with ExoPlayer and handing anything ExoPlayer can't play to libmpv. The source is
          <a href={repo}>on GitHub</a>.
        </p>
      </div>
    </section>

    <div class="final">
      <div class="wrap">
        <h2>Ready to watch?</h2>
        <div class="buttons">
          <a class="btn" href={download} data-platform="windows">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5 10.4 4.5v7H3zM11.4 4.4 21 3v8.5h-9.6zM3 12.5h7.4v7L3 18.5zM11.4 12.5H21V21l-9.6-1.4z"/></svg>
            Download for Windows
          </a>
          <a class="btn secondary" href={apk} data-platform="android">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.6 9.48l1.84-3.18a.38.38 0 0 0-.66-.38l-1.86 3.22A11.5 11.5 0 0 0 12 8.2c-1.76 0-3.42.34-4.92.94L5.22 5.92a.38.38 0 0 0-.66.38L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z"/></svg>
            Download for Android
          </a>
        </div>
        <details>
          <summary>Windows says it "protected your PC"?</summary>
          <p>That's because the installer isn't signed with a paid certificate yet, not because anything is wrong with it. Click <b>More info</b>, then <b>Run anyway</b>.</p>
          <p>To uninstall, go to <b>Settings › Apps › Installed apps</b>, find Vessel, and choose <b>Uninstall</b>.</p>
        </details>
        <details>
          <summary>Installing on Android?</summary>
          <p>Open the downloaded <b>Vessel.apk</b>. The first time, Android asks you to allow your browser to install apps: turn on <b>Allow from this source</b>, then go back and tap <b>Install</b>.</p>
          <p>Already have Vessel? Installing a newer version updates it and keeps your history and settings. Or use <a href="/">Jeti</a>, which installs and updates it for you.</p>
        </details>
        <p class="credits">
          Videos in the screenshots: <i>Big Buck Bunny</i>, <i>Elephants Dream</i>, <i>Sintel</i> and
          <i>Tears of Steel</i> © Blender Foundation, <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>
          (<a href="https://studio.blender.org/films/">studio.blender.org</a>). Space footage courtesy of NASA.
        </p>
      </div>
    </div>
  </div>

  <Fragment slot="footer-links">
    <a href={repo}>Vessel source</a>
    <a href={`${repo}/releases`}>Releases</a>
  </Fragment>
</Base>

<script>
  // On an Android phone, the Android download is the main button.
  if (/Android/i.test(navigator.userAgent)) {
    document.querySelectorAll('.buttons').forEach((group) => {
      const android = group.querySelector('[data-platform="android"]');
      const windows = group.querySelector('[data-platform="windows"]');
      if (!android || !windows) return;
      android.classList.remove('secondary');
      windows.classList.add('secondary');
      group.prepend(android);
    });
  }

  // Shows the newest version next to the download button.
  fetch('https://api.github.com/repos/BersamaMus/Vessel/releases/latest')
    .then((r) => (r.ok ? r.json() : null))
    .then((r) => {
      const el = document.getElementById('version');
      if (el && r && r.tag_name) el.textContent = 'Free · ' + r.tag_name;
    })
    .catch(() => {});
</script>

<style>
  /* Vessel's own colour, light purple, comes from .accent-purple in global.css. */

  .hero {
    text-align: center;
    padding: 48px 0 0;
    background: radial-gradient(700px 360px at 50% 0, var(--glow), transparent 70%);
  }
  .name {
    display: inline-flex; align-items: center; gap: 10px; margin: 0 0 20px;
    font-weight: 700; font-size: 20px;
  }
  .name img { border-radius: 9px; }
  h1 { font-size: clamp(36px, 7vw, 64px); line-height: 1.08; letter-spacing: -1.5px; margin: 0; }
  h1 span { color: var(--accent); }
  .lead { color: var(--text-2); font-size: clamp(17px, 2.4vw, 20px); max-width: 620px; margin: 20px auto 0; }
  .cta { margin-top: 32px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .cta small { color: var(--text-3); font-size: 14px; }
  .buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .cta small a { color: var(--text-2); }
  .shot {
    display: block; margin: 48px auto 0; width: 100%; max-width: 1000px; height: auto;
    border-radius: 12px; border: 1px solid var(--line);
    box-shadow: var(--shadow), 0 0 0 1px rgba(var(--brand-rgb), .06);
  }

  section { padding: 88px 0 0; }
  h2 { font-size: clamp(26px, 4vw, 36px); letter-spacing: -.5px; margin: 0 0 8px; }
  .sub { color: var(--text-2); margin: 0 0 36px; max-width: 640px; }

  .features { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 16px; }
  .feature { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .feature .icon {
    width: 40px; height: 40px; border-radius: 10px;
    background: var(--accent-soft); color: var(--accent);
    display: grid; place-items: center; margin-bottom: 14px;
  }
  .feature .icon svg { width: 22px; height: 22px; }
  .feature h3 { margin: 0 0 6px; font-size: 18px; }
  .feature p { margin: 0; color: var(--text-2); font-size: 15px; }

  .desktop { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 12px 32px; list-style: none; padding: 0; margin: 0; }
  .desktop li { padding-left: 26px; position: relative; color: var(--text-2); }
  .desktop li::before { content: ""; position: absolute; left: 0; top: .5em; width: 10px; height: 10px; border-radius: 3px; background: var(--brand); }
  .desktop li b { color: var(--text); font-weight: 600; }
  kbd { font: 600 13px/1 inherit; background: var(--surface-high); border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 6px; padding: 2px 6px; color: var(--text); }

  .final { text-align: center; padding: 96px 0 0; }
  .final h2 { margin-bottom: 24px; }
  .final details { max-width: 560px; margin: 28px auto 0; text-align: left; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 18px; }
  .final summary { cursor: pointer; font-weight: 600; color: var(--text-2); }
  .final details p { color: var(--text-2); font-size: 15px; margin: 12px 0 0; }
  .credits { color: var(--text-3); font-size: 13px; max-width: 640px; margin: 40px auto 0; }
  .credits a { color: var(--text-2); }

  @media (max-width: 760px) {
    section { padding-top: 64px; }
  }
</style>
