---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { links } from '../../site';
import icon from '../../assets/blimp/icon.png';
import windowsHome from '../../assets/blimp/windows-home.png';
import windowsPlayer from '../../assets/blimp/windows-player.png';
import phoneHome from '../../assets/blimp/phone-home.jpg';
import phonePlayer from '../../assets/blimp/phone-player.jpg';
import phoneVisualizer from '../../assets/blimp/phone-visualizer.jpg';

const repo = 'https://github.com/BersamaMus/Blimp';
const download = `${repo}/releases/latest/download/Blimp-Setup.exe`;
// The Android app, from the same release. A newer one installs over the old one and keeps its library.
const apk = `${repo}/releases/latest/download/Blimp.apk`;
---

<Base
  title="Blimp: offline music player for Windows and Android"
  description="Blimp plays the music already on your device, with a live visualizer, synced lyrics and hi-res audio. No accounts, no ads, no internet."
  image={windowsHome.src}
  favicon={icon.src}
  section="projects"
>
  <div class="hero">
    <div class="wrap">
      <p class="name"><Image src={icon} alt="" width={36} height={36} />Blimp</p>
      <h1>Your music.<br /><span>Beautifully played.</span></h1>
      <p class="lead">
        Blimp plays the music already on your PC, with a live visualizer, synced lyrics and
        hi-res audio. No accounts, no ads, no internet.
      </p>
      <div class="cta">
        <div class="buttons">
          <a class="btn" href={download} data-platform="windows">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5 10.4 4.5v7H3zM11.4 4.4 21 3v8.5h-9.6zM3 12.5h7.4v7L3 18.5zM11.4 12.5H21V21l-9.6-1.4z"/></svg>
            Download for Windows
          </a>
          <a class="btn secondary" href={apk} data-platform="android">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.6 9.48l1.84-3.18a.38.38 0 0 0-.66-.38l-1.86 3.22A11.5 11.5 0 0 0 12 8.2c-1.76 0-3.42.34-4.92.94L5.22 5.92a.38.38 0 0 0-.66.38L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z"/></svg>
            Download for Android
          </a>
        </div>
        <small><span id="version">Free</span> · Windows 10 and 11, 64-bit · Android 7.0 and up · <a href={`${repo}/releases`}>All releases</a>{links.support && <> · <a href={links.support}>Support Blimp</a></>}</small>
      </div>
      <Image class="shot" src={windowsHome} alt="Blimp on Windows, showing Quick picks, recently played albums and the player bar" loading="eager" />
    </div>
  </div>

  <section>
    <div class="wrap">
      <h2>Everything your music deserves</h2>
      <p class="sub">Point Blimp at your music folder and it does the rest.</p>
      <div class="features">
        <div class="feature">
          <div class="icon"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="10" width="3" height="10" rx="1.5"/><rect x="8" y="5" width="3" height="15" rx="1.5"/><rect x="13" y="8" width="3" height="12" rx="1.5"/><rect x="18" y="3" width="3" height="17" rx="1.5"/></svg></div>
          <h3>Live visualizer</h3>
          <p>Bars, Mirror, Wave, Radial and Pulse, moving with every beat of what's playing.</p>
        </div>
        <div class="feature">
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h10M4 18h13"/></svg></div>
          <h3>Synced lyrics</h3>
          <p>Lines light up as they're sung. Read from your files' tags or <code>.lrc</code> files beside them.</p>
        </div>
        <div class="feature">
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h2l2-6 3 12 3-9 2 6 2-3h4"/></svg></div>
          <h3>Sounds right</h3>
          <p>Hi-res badges, volume normalisation, smooth fades between songs and a waveform seek bar.</p>
        </div>
        <div class="feature">
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></div>
          <h3>Your library, your way</h3>
          <p>Songs, albums, artists, genres and folders. Albums sorted into Albums, EPs and Singles. Search that ignores accents.</p>
        </div>
        <div class="feature">
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></div>
          <h3>Listening stats</h3>
          <p>Your top songs, artists and genres, and how much you listened today, this week or ever.</p>
        </div>
        <div class="feature">
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z"/></svg></div>
          <h3>Private by design</h3>
          <p>Blimp never goes online. It doesn't collect, share or upload anything. <a href="/blimp/privacy">Privacy policy</a></p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Made for the desktop</h2>
      <p class="sub">Not a phone app in a window. Blimp fits in with Windows.</p>
      <ul class="desktop">
        <li><b>Media keys</b> and the Windows media flyout</li>
        <li><b>Keeps playing in the tray</b> when you close the window</li>
        <li><b>Pauses</b> when your headphones are unplugged</li>
        <li><b>Sortable song table</b> for big libraries</li>
        <li><b>Remembers</b> its size and place on screen</li>
        <li><b>Shortcuts:</b> <kbd>Space</kbd> play, <kbd>Ctrl</kbd>+<kbd>←</kbd>/<kbd>→</kbd> skip, <kbd>Ctrl</kbd>+<kbd>F</kbd> search</li>
      </ul>
      <Image class="shot" src={windowsPlayer} alt="Blimp's now playing screen on Windows, with the album cover, waveform seek bar and controls" />
    </div>
  </section>

  <section>
    <div class="wrap android">
      <div>
        <span class="chip">Android 7.0 and up</span>
        <h2>Also on Android</h2>
        <p class="sub">The same Blimp on your phone, with Android Auto, home screen widgets, lock screen controls and a sleep timer. Install it from here now; it's coming to Google Play too.</p>
        <a class="btn" href={apk}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.6 9.48l1.84-3.18a.38.38 0 0 0-.66-.38l-1.86 3.22A11.5 11.5 0 0 0 12 8.2c-1.76 0-3.42.34-4.92.94L5.22 5.92a.38.38 0 0 0-.66.38L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z"/></svg>
          Download for Android
        </a>
      </div>
      <div class="phones">
        <Image src={phoneHome} alt="Blimp on Android: Home" />
        <Image src={phonePlayer} alt="Blimp on Android: now playing" />
        <Image src={phoneVisualizer} alt="Blimp on Android: visualizer" />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Under the hood</h2>
      <p class="sub">
        Blimp is one Flutter codebase for Android and Windows. Playback runs on just_audio and
        audio_service, with media_kit on Windows and a customised just_audio_background that adds
        Android Auto browsing. The source is <a href={repo}>on GitHub</a>.
      </p>
    </div>
  </section>

  <div class="final">
    <div class="wrap">
      <h2>Ready to listen?</h2>
      <div class="buttons">
        <a class="btn" href={download} data-platform="windows">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5 10.4 4.5v7H3zM11.4 4.4 21 3v8.5h-9.6zM3 12.5h7.4v7L3 18.5zM11.4 12.5H21V21l-9.6-1.4z"/></svg>
          Download for Windows
        </a>
        <a class="btn secondary" href={apk} data-platform="android">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.6 9.48l1.84-3.18a.38.38 0 0 0-.66-.38l-1.86 3.22A11.5 11.5 0 0 0 12 8.2c-1.76 0-3.42.34-4.92.94L5.22 5.92a.38.38 0 0 0-.66.38L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z"/></svg>
          Download for Android
        </a>
      </div>
      {links.support && (
        <p class="support">Blimp is free. If you enjoy it, you can <a href={links.support}>leave a tip</a> to support its development.</p>
      )}
      <details>
        <summary>Windows says it "protected your PC"?</summary>
        <p>That's because the installer isn't signed with a paid certificate yet, not because anything is wrong with it. Click <b>More info</b>, then <b>Run anyway</b>.</p>
        <p>To uninstall, go to <b>Settings › Apps › Installed apps</b>, find Blimp, and choose <b>Uninstall</b>.</p>
      </details>
      <details>
        <summary>Installing on Android?</summary>
        <p>Open the downloaded <b>Blimp.apk</b>. The first time, Android asks you to allow your browser to install apps: turn on <b>Allow from this source</b>, then go back and tap <b>Install</b>.</p>
        <p>Already have Blimp? Installing a newer version updates it and keeps your library, playlists and settings.</p>
      </details>
      <p class="credits">
        Music in the screenshots, from the <a href="https://archive.org/details/netlabels">Internet Archive</a> under
        Creative Commons licences (<a href="https://creativecommons.org/licenses/by/3.0/">BY</a> or
        <a href="https://creativecommons.org/licenses/by-sa/3.0/">BY-SA</a>), with their covers: Doc &amp; Lena Selyanina,
        Grove of Whispers, Lingua Lustra, Memphis, Softspace, KraftiM, Resistranz, The Ambient Collective, Mikael Lind,
        Growsound, Luxurious Dagger, Deadman &amp; Digi Hartatak and Digi Hartatak. "Shenandoah" by the U.S. Air Force
        Band's Singing Sergeants, and the Shenandoah Valley photo used as its cover, are public domain (U.S. Air Force,
        National Park Service).
      </p>
    </div>
  </div>

  <Fragment slot="footer-links">
    <a href={repo}>Blimp source</a>
    <a href={`${repo}/releases`}>Releases</a>
    <a href="/blimp/privacy">Blimp privacy</a>
  </Fragment>
</Base>

<script>
  // On an Android phone, the Android download is the main button.
  if (/Android/i.test(navigator.userAgent)) {
    document.querySelectorAll('.buttons').forEach((group) => {
      const android = group.querySelector('[data-platform="android"]');
      const windows = group.querySelector('[data-platform="windows"]');
      if (!android || !windows) return;
      android.classList.remove('secondary');
      windows.classList.add('secondary');
      group.prepend(android);
    });
  }

  // Shows the newest version next to the download button.
  fetch('https://api.github.com/repos/BersamaMus/Blimp/releases/latest')
    .then((r) => (r.ok ? r.json() : null))
    .then((r) => {
      const el = document.getElementById('version');
      if (el && r && r.tag_name) el.textContent = 'Free · ' + r.tag_name;
    })
    .catch(() => {});
</script>

<style>
  .hero {
    text-align: center;
    padding: 48px 0 0;
    background: radial-gradient(700px 360px at 50% 0, var(--glow), transparent 70%);
  }
  .name {
    display: inline-flex; align-items: center; gap: 10px; margin: 0 0 20px;
    font-weight: 700; font-size: 20px;
  }
  .name img { border-radius: 9px; }
  h1 { font-size: clamp(36px, 7vw, 64px); line-height: 1.08; letter-spacing: -1.5px; margin: 0; }
  h1 span { color: var(--accent); }
  .lead { color: var(--text-2); font-size: clamp(17px, 2.4vw, 20px); max-width: 620px; margin: 20px auto 0; }
  .cta { margin-top: 32px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .cta small { color: var(--text-3); font-size: 14px; }
  .cta small a { color: var(--text-2); }
  .shot {
    margin: 48px auto 0; width: 100%; max-width: 1000px;
    border-radius: 12px; border: 1px solid var(--line);
    box-shadow: var(--shadow), 0 0 0 1px rgba(var(--brand-rgb), .06);
  }

  section { padding: 88px 0 0; }
  h2 { font-size: clamp(26px, 4vw, 36px); letter-spacing: -.5px; margin: 0 0 8px; }
  .sub { color: var(--text-2); margin: 0 0 36px; max-width: 640px; }

  .features { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 16px; }
  .feature { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .feature .icon {
    width: 40px; height: 40px; border-radius: 10px;
    background: var(--accent-soft); color: var(--accent);
    display: grid; place-items: center; margin-bottom: 14px;
  }
  .feature .icon svg { width: 22px; height: 22px; }
  .feature h3 { margin: 0 0 6px; font-size: 18px; }
  .feature p { margin: 0; color: var(--text-2); font-size: 15px; }

  .desktop { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 12px 32px; list-style: none; padding: 0; margin: 0; }
  .desktop li { padding-left: 26px; position: relative; color: var(--text-2); }
  .desktop li::before { content: ""; position: absolute; left: 0; top: .5em; width: 10px; height: 10px; border-radius: 3px; background: var(--brand); }
  .desktop li b { color: var(--text); font-weight: 600; }
  kbd { font: 600 13px/1 inherit; background: var(--surface-high); border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 6px; padding: 2px 6px; color: var(--text); }

  .android { display: grid; grid-template-columns: 1fr 1.2fr; gap: 48px; align-items: center; }
  .android .chip { margin-bottom: 14px; }
  .android .sub { margin-bottom: 24px; }
  .phones { display: flex; gap: 14px; justify-content: center; max-width: 480px; margin: 0 auto; padding-top: 20px; }
  .phones img { width: 31%; border-radius: 18px; border: 1px solid var(--line); }
  .phones img:nth-child(2) { transform: translateY(-20px); }

  .final { text-align: center; padding: 96px 0 0; }
  .final h2 { margin-bottom: 24px; }
  .final .support { color: var(--text-2); max-width: 560px; margin: 20px auto 0; }
  .final details { max-width: 560px; margin: 28px auto 0; text-align: left; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 18px; }
  .final summary { cursor: pointer; font-weight: 600; color: var(--text-2); }
  .final details p { color: var(--text-2); font-size: 15px; margin: 12px 0 0; }
  .final details + details { margin-top: 12px; }
  .credits { color: var(--text-3); font-size: 13px; max-width: 640px; margin: 40px auto 0; }
  .credits a { color: var(--text-2); }

  @media (max-width: 760px) {
    .android { grid-template-columns: 1fr; gap: 32px; }
    section { padding-top: 64px; }
  }
</style>
